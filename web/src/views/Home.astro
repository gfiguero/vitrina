---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Role from '../components/Role.astro';
import { data, t, projects, roles } from '../../../lib/data.mjs';

const { locale = 'es' } = Astro.props;
const es = locale === 'es';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const p = (path) => `${base}${es ? '' : '/en'}${path}` || '/';
const featured = projects({ featuredOnly: true }).slice(0, 3);
const current = roles().filter((r) => r.current);
---
<Base locale={locale} page="" >
  <p class="eyebrow">{t(data.profile.headline, locale)}</p>
  <h1>{data.profile.name}</h1>
  <p class="lead">{t(data.profile.tagline, locale)}</p>

  <div class="actions">
    <a class="btn btn-primary" href={p('/cv')}>{es ? 'Ver CV' : 'View CV'}</a>
    <a class="btn" href={p(es ? '/proyectos' : '/projects')}>{es ? 'Proyectos' : 'Projects'}</a>
    <a class="btn" href={`mailto:${data.profile.email}`}>{es ? 'Escríbeme' : 'Get in touch'}</a>
  </div>

  <h2>{es ? 'En qué estoy' : 'What I am building'}</h2>
  {current.map((role) => <Role role={role} locale={locale} />)}

  <h2>{es ? 'Trabajo seleccionado' : 'Selected work'}</h2>
  <div class="cards">
    {featured.map((project) => <ProjectCard project={project} locale={locale} />)}
  </div>
  <p class="actions">
    <a class="btn" href={p(es ? '/proyectos' : '/projects')}>{es ? 'Todos los proyectos' : 'All projects'}</a>
  </p>

  <h2>{es ? 'Open source' : 'Open source'}</h2>
  <p class="muted">{t(data.opensource.intro, locale)}</p>
  {data.opensource.contributions.map((c) => (
    <article class="entry">
      <div class="entry-head">
        <h3><a href={c.url}>{c.ref}</a></h3>
        <span class="entry-meta">{c.year}</span>
      </div>
      <p class="muted">{t(c.summary, locale)}</p>
    </article>
  ))}
  <p class="note">{t(data.opensource.note, locale)}</p>
</Base>
