---
import '../styles/global.css';
import { data, t } from '../../../lib/data.mjs';

const { locale = 'es', title, description, page = '' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const p = (path) => `${base}${locale === 'en' ? '/en' : ''}${path}` || '/';

const nav = locale === 'es'
  ? [['', 'Inicio'], ['/trayectoria', 'Trayectoria'], ['/proyectos', 'Proyectos'], ['/cv', 'CV']]
  : [['', 'Home'], ['/career', 'Career'], ['/projects', 'Projects'], ['/cv', 'CV']];

// La misma página en el otro idioma.
const alt = locale === 'es'
  ? { href: `${base}/en${{ '': '', '/trayectoria': '/career', '/proyectos': '/projects', '/cv': '/cv' }[page] ?? ''}`, label: 'English' }
  : { href: `${base}${{ '': '', '/career': '/trayectoria', '/projects': '/proyectos', '/cv': '/cv' }[page] ?? ''}` || '/', label: 'Español' };

const fullTitle = title ? `${title} · ${data.profile.name}` : data.profile.name;
const desc = description ?? t(data.profile.tagline, locale);
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(`${base}/og.png`, Astro.site);

// Datos estructurados: permiten que los buscadores entiendan que la página describe
// a una persona concreta, con su empleador y sus perfiles.
const current = data.experience.roles.find((r) => r.current);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: data.profile.name,
  jobTitle: t(data.profile.headline, locale),
  description: desc,
  email: `mailto:${data.profile.email}`,
  url: canonical.href,
  image: ogImage.href,
  address: { '@type': 'PostalAddress', addressLocality: 'Buin', addressRegion: 'Región Metropolitana', addressCountry: 'CL' },
  sameAs: data.profile.links.map((l) => l.url),
  worksFor: current ? { '@type': 'Organization', name: t(current.company, locale), url: current.url ?? undefined } : undefined,
  knowsLanguage: data.skills.languages_spoken.map((l) => t(l.name, 'en')),
};
---
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content="profile" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={locale === 'es' ? 'es_CL' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={locale === 'es' ? 'en' : 'es'} href={new URL(alt.href || '/', Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL(base || '/', Astro.site)} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <header class="site-head">
      <div class="wrap">
        <a class="brand" href={p('')}>{data.profile.name}</a>
        <nav class="site-nav">
          {nav.map(([href, label]) => (
            <a href={p(href) || '/'} aria-current={page === href ? 'page' : undefined}>{label}</a>
          ))}
        </nav>
        <a class="lang" href={alt.href || '/'}>{alt.label}</a>
      </div>
    </header>

    <main><div class="wrap"><slot /></div></main>

    <footer class="site-foot">
      <div class="wrap">
        <span>© {new Date().getFullYear()} {data.profile.name} · {t(data.profile.location, locale)}</span>
        <span>
          {data.profile.links.map((l, i) => (
            <>{i > 0 ? ' · ' : ''}<a href={l.url}>{l.label}</a></>
          ))}
          {' · '}<a href={`mailto:${data.profile.email}`}>{data.profile.email}</a>
        </span>
      </div>
    </footer>
  </body>
</html>
